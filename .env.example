# 复制为 .env 并填写：cp .env.example .env

# 照片/视频目录的宿主机绝对路径（只读挂载进容器 /data）
MEDIA_DIR=/home/user/projects/u/bone-ash

# YouTube OAuth token：token.json 的单行 JSON 内容
# 用下面一行命令直接生成 .env 最省事（生成后记得改上面的 MEDIA_DIR）：
#   { echo "MEDIA_DIR=/home/user/projects/u/bone-ash"; echo -n "TUBETAPE_TOKEN="; cat token.json; echo; } > .env
TUBETAPE_TOKEN=
